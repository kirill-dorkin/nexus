{
  "name": "@platform/checks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "server": [
        "src/server.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "require": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/mark-commonjs-dist.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "css-select": "5.2.2",
    "domhandler": "5.0.3",
    "parse5": "7.3.0",
    "parse5-htmlparser2-tree-adapter": "7.1.0"
  },
  "devDependencies": {
    "happy-dom": "20.0.10",
    "typescript": "^5.9.0"
  }
}
