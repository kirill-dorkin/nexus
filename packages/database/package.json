{
  "name": "@platform/database",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/mark-commonjs-dist.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/cli/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "^5.9.0"
  }
}
