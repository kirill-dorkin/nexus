{
  "name": "@platform/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "grader": ["src/grader.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./grader": {
      "types": "./src/grader.ts",
      "import": "./src/grader.ts",
      "require": "./dist/grader.js",
      "default": "./dist/grader.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/mark-commonjs-dist.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
