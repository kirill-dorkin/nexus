{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "src/main.ts",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm --dir ../.. exec turbo run build --filter=@platform/api^...",
      "outputDirectory": ".",
      "devCommand": "pnpm --dir ../.. exec turbo run build --filter=@platform/api && node dist/main.js"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "NEXT_PUBLIC_API_ORIGIN=/ pnpm --dir ../.. exec turbo run build --filter=@platform/web",
      "devCommand": "NEXT_PUBLIC_API_ORIGIN=/ pnpm exec next dev --hostname 127.0.0.1 --port $PORT",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_INTERNAL_URL"
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/v1", "destination": { "service": "api" } },
    { "source": "/v1/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
