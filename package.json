{
  "name": "learning-platform-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.34.5 <11"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck && tsc -p tsconfig.json",
    "lint": "pnpm --filter @platform/web exec next typegen && NODE_OPTIONS=--max-old-space-size=6144 eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:web-coverage": "vitest run --coverage --project web-components --project ui-components --project node apps/web packages/ui",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:launch-performance": "vitest run --config vitest.launch-performance.config.ts",
    "test:browser-launch": "node tests/public-launch-browser/run.mjs",
    "test:watch": "vitest",
    "check": "pnpm check:brand && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:web-coverage",
    "dev:infra": "docker compose up -d postgres redis",
    "dev:infra:down": "docker compose down",
    "db:migrate": "pnpm --filter @platform/database db:migrate",
    "db:bootstrap:neon": "node scripts/bootstrap-neon.mjs",
    "rebrand": "node scripts/rebrand.mjs",
    "check:brand": "node scripts/check-brand-leaks.mjs",
    "org:bootstrap-owner": "pnpm --filter @platform/database exec tsx ../../apps/api/ops/provision-owner-organization.ts"
  },
  "scarfSettings": {
    "enabled": false
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.5",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.11"
  }
}
