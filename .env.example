NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
GRADER_GATEWAY_PORT=4100
GRADER_GATEWAY_URL=http://127.0.0.1:4100
GRADER_GATEWAY_SERVICE_TOKEN=replace-with-at-least-32-random-bytes
GRADER_GATEWAY_TIMEOUT_MS=45000
GRADER_WORKER_LEASE_SECONDS=60
GRADER_WORKER_POLL_INTERVAL_MS=1000
GRADER_WORKER_RETRY_BASE_MS=1000
GRADER_WORKER_RETRY_MAX_MS=60000
GRADER_EXECUTION_PROFILES_JSON=
GRADER_SANDBOX_PROVIDER=unavailable
GRADER_SANDBOX_NAMESPACE=nexus-grader-sandbox
GRADER_SANDBOX_RUNTIME_CLASS=gvisor
GRADER_SANDBOX_SERVICE_ACCOUNT=grader-sandbox
GRADER_SANDBOX_RUNNER_IMAGE_REPOSITORY=
GRADER_SANDBOX_STARTUP_TIMEOUT_MS=10000
GRADER_SANDBOX_POLL_INTERVAL_MS=250
GRADER_SANDBOX_RESULT_RETENTION_SECONDS=300
GRADER_KUBERNETES_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
GRADER_KUBERNETES_CA_PATH=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
DATABASE_URL=postgresql://platform_app:platform_app@localhost:5432/platform
DATABASE_MIGRATION_URL=postgresql://platform_migrator:platform_migrator@localhost:5432/platform
DATABASE_WORKER_URL=postgresql://platform_worker:platform_worker@localhost:5432/platform
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-bytes
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_OAUTH_CALLBACK_URL=http://localhost:4000/v1/integrations/github/oauth/callback
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=
